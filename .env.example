PORT=3000
# Choose a password and generate a separate random secret. Never commit .env.
ASSISTANT_PASSWORD=
ASSISTANT_SESSION_SECRET=
# Local path; on Render this MUST point inside an attached persistent disk.
ASSISTANT_DATA_DIR=
GEMINI_API_KEY=
# Set an available Gemini model ID for your account.
GEMINI_MODEL=
YANDEX_DISK_TOKEN=
FRONTPAD_LOGIN=
FRONTPAD_PASSWORD=
# Run: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
