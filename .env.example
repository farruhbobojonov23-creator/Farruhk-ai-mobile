PORT=3000
# Choose a password and generate a separate random secret. Never commit .env.
ASSISTANT_PASSWORD=
ASSISTANT_SESSION_SECRET=
# Local path; on Render this MUST point inside an attached persistent disk.
ASSISTANT_DATA_DIR=
GEMINI_API_KEY=
# Set an available Gemini model ID for your account.
GEMINI_MODEL=
YANDEX_DISK_TOKEN=
# Optional read-only recovery on Yandex 360 using a WebDAV application password.
# Do not put credentials in Git or share them in chat; configure only in Render.
YANDEX_WEBDAV_LOGIN=
YANDEX_WEBDAV_APP_PASSWORD=
FRONTPAD_LOGIN=
FRONTPAD_PASSWORD=
# Run: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
